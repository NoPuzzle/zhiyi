  "zhuan": {
    "tuanParagraphs": [
      "節，亨，剛柔分，而剛得中。苦節不可貞，其道窮也。說以行險，當位以節，中正以通。天地節而四時成，節以制度，不傷財，不害民。"
    ],
    "greatImageText": "澤上有水，節。君子以制數度，議德行。",
    "smallImageTexts": [
      {
        "position": "初九",
        "original": "不出戶庭，知通塞也。"
      },
      {
        "position": "九二",
        "original": "不出門庭，失時極也。"
      },
      {
        "position": "六三",
        "original": "不節之嗟，又誰咎也。"
      },
      {
        "position": "六四",
        "original": "安節之亨，承上道也。"
      },
      {
        "position": "九五",
        "original": "甘節之吉，居位中也。"
      },
      {
        "position": "上六",
        "original": "苦節貞凶，其道窮也。"
      }
    ]
  }
