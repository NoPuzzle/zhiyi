  "jing": {
    "judgmentOriginal": "亨，苦節不可貞。",
    "lineTexts": [
      {
        "position": "初九",
        "original": "不出戶庭，無咎。"
      },
      {
        "position": "九二",
        "original": "不出門庭，凶。"
      },
      {
