  "jing": {
    "judgmentOriginal": "有孚，窒惕，中吉。終凶。利見大人，不利涉大川。",
    "lineTexts": [
      {
        "position": "初六",
        "original": "不永所事，小有言，終吉。"
      },
      {
        "position": "九二",
        "original": "不克訟，歸而逋其邑。人三百戶，無眚。"
      },
      {
        "position": "六三",
        "original": "食舊德，貞厲，終吉。或從王事無成。"
      },
      {
        "position": "九四",
        "original": "不克訟。復即命渝，安貞吉。"
      },
      {
        "position": "九五",
        "original": "訟元吉。"
      },
      {
        "position": "上九",
        "original": "或錫之鞶帶，終朝三褫之。"
      }
    ]
  },
  "zhuan": {
    "tuanParagraphs": [
      "訟，上剛下險，險而健，訟。訟，有孚，窒，惕，中吉，剛來而得中也。終凶，訟不可成也。利見大人，尚中正也。不利涉大川，入于淵也。"
    ],
    "greatImageText": "天與水違行，訟。君子以作事謀始。",
    "smallImageTexts": [
      {
        "position": "初六",
        "original": "不永所事，訟不可長也。雖小有言，其辯明也。"
      },
      {
        "position": "九二",
        "original": "不克訟，歸逋竄也。自下訟上，患至掇也。"
      },
      {
        "position": "六三",
        "original": "食舊德，從上吉也。"
      },
      {
        "position": "九四",
        "original": "復即命渝，安貞，不失也。"
      },
      {
        "position": "九五",
        "original": "訟，元吉，以中正也。"
      },
      {
        "position": "上九",
        "original": "以訟受服，亦不足敬也。"
      }
    ]
  }
