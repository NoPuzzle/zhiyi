  "zhuan": {
    "tuanParagraphs": [
      "頤中有物，曰噬嗑，噬嗑而亨。剛柔分，動而明，雷電合而章。柔得中而上行，雖不當位，利用獄也。"
    ],
    "greatImageText": "「雷電」「噬嗑」，先王以明罰敕法。",
    "smallImageTexts": [
      {
        "position": "初九",
        "original": "屨校滅趾，不行也。"
      },
      {
