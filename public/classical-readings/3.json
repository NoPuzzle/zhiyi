  "name": "屯",
  "revisionUrl": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%E6%AD%A3%E7%BE%A9%2F01%E5%B1%AF&oldid=2689596",
  "jing": {
    "judgmentOriginal": "元、亨、利、貞。勿用有攸往，利建侯。",
    "lineTexts": [
      {
        "position": "初九",
        "original": "磐桓，利居貞，利建侯。"
      },
      {
        "position": "六二",
        "original": "屯如邅如，乘馬班如，匪寇婚媾。女子貞不字，十年乃字。"
      },
      {
        "position": "六三",
        "original": "即鹿無虞，惟入於林中。君子幾，不如舍，往吝。"
      },
      {
        "position": "六四",
        "original": "乘馬班如，求婚媾，往吉，無不利。"
      },
      {
        "position": "九五",
        "original": "屯其膏，小貞吉，大貞凶。"
      },
      {
        "position": "上六",
        "original": "乘馬班如，泣血漣如。"
      }
    ]
  },
  "zhuan": {
    "tuanParagraphs": [
      "屯，剛柔始交而難生，動乎險中，大亨貞。雷雨之動滿盈，天造草昧，宜建侯而不寧。"
    ],
    "greatImageText": "雲雷屯，君子以經綸。",
    "smallImageTexts": [
      {
        "position": "初九",
        "original": "雖磐桓，志行正也。以貴下賤，大得民也。"
      },
      {
        "position": "六二",
        "original": "六二之難，乘剛也。十年乃字，反常也。"
      },
      {
        "position": "六三",
        "original": "即鹿无虞，以從禽也。君子舍之，往吝窮也。"
      },
      {
        "position": "六四",
        "original": "求而往，明也。"
      },
      {
        "position": "九五",
        "original": "屯其膏，施未光也。"
      },
      {
        "position": "上六",
        "original": "泣血漣如，何可長也。"
      }
    ]
  }
}
