  "name": "姤",
  "revisionUrl": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%E6%AD%A3%E7%BE%A9%2F05%E5%A7%A4&oldid=2404972",
  "jing": {
    "judgmentOriginal": "女壯，勿用取女。",
    "lineTexts": [
      {
        "position": "初六",
        "original": "繫於金柅，貞吉。有攸往，見凶。羸豕孚蹢躅。"
      },
      {
        "position": "九二",
        "original": "包有魚，無咎，不利賓。"
      },
      {
        "position": "九三",
        "original": "臀無膚，其行次且，厲，無大咎。"
      },
      {
        "position": "九四",
        "original": "包無魚，起凶。"
      },
      {
        "position": "九五",
        "original": "以杞包瓜，含章，有隕自天。"
      },
      {
        "position": "上九",
        "original": "姤其角，吝，無咎。"
      }
    ]
  },
  "zhuan": {
    "tuanParagraphs": [
      "姤，遇也，柔遇剛也。勿用取女，不可與長也。天地相遇，品物咸章也。剛遇中正，天下大行也。姤之時義大矣哉！"
    ],
    "greatImageText": "天下有風，姤。後以施命誥四方。",
    "smallImageTexts": [
      {
        "position": "初六",
        "original": "系于金柅，柔道牽也。"
      },
      {
        "position": "九二",
        "original": "包有魚，義不及賓也。"
      },
      {
        "position": "九三",
        "original": "其行次且，行未牽也。"
      },
      {
        "position": "九四",
        "original": "无魚之凶，遠民也。"
      },
      {
        "position": "九五",
        "original": "九五含章，中正也。有隕自天，志不舍命也。"
      },
      {
        "position": "上九",
        "original": "姤其角，上窮吝也。"
      }
    ]
  }
}
