  "jing": {
    "judgmentOriginal": "元亨，用見大人，勿恤。南征吉。",
    "lineTexts": [
      {
        "position": "初六",
        "original": "允升，大吉。"
      },
      {
        "position": "九二",
        "original": "孚乃利用禴，無咎。"
      },
      {
        "position": "九三",
        "original": "升虛邑。"
      },
      {
        "position": "六四",
        "original": "王用亨於岐山，吉，無咎。"
      },
      {
        "position": "六五",
        "original": "貞吉，升階。"
      },
      {
        "position": "上六",
        "original": "冥升，利於不息之貞。"
      }
    ]
  },
  "zhuan": {
    "tuanParagraphs": [
      "柔以時升，巽而順，剛中而應，是以大亨。用見大人，勿恤；有慶也。南征吉，志行也。"
    ],
    "greatImageText": "地中生木，升。君子以順德，積小以高大。",
    "smallImageTexts": [
      {
        "position": "初六",
        "original": "允升大吉，上合志也。"
      },
      {
        "position": "九二",
        "original": "九二之孚，有喜也。"
      },
      {
        "position": "九三",
        "original": "升虛邑，无所疑也。"
      },
      {
        "position": "六四",
        "original": "王用亨于岐山，順事也。"
      },
      {
        "position": "六五",
        "original": "貞吉升階，大得志也。"
      },
      {
        "position": "上六",
        "original": "冥升在上，消不富也。"
      }
    ]
