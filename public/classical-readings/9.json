  "jing": {
    "judgmentOriginal": "亨。密雲不雨，自我西郊。",
    "lineTexts": [
      {
        "position": "初九",
        "original": "復自道，何其咎，吉。"
      },
      {
        "position": "九二",
        "original": "牽復吉。"
      },
      {
        "position": "九三",
        "original": "輿說輻。夫妻反目。"
      },
      {
        "position": "六四",
        "original": "有孚，血去惕出，無咎。"
      },
      {
        "position": "九五",
        "original": "有孚攣如，富以其鄰。"
      },
      {
        "position": "上九",
        "original": "既雨既處，尚德載，婦貞厲，月幾望，君子征凶。"
      }
    ]
  },
  "zhuan": {
    "tuanParagraphs": [
      "小畜，柔得位而上下應之，曰小畜。健而巽，剛中而志行，乃亨。密雲不雨，尚往也。自我西郊，施未行也。"
    ],
    "greatImageText": "風行天上，小畜。君子以懿文德。",
    "smallImageTexts": [
      {
        "position": "初九",
        "original": "復自道，其義吉也。"
      },
      {
        "position": "九二",
        "original": "牽復在中，亦不自失也。"
      },
      {
        "position": "九三",
        "original": "夫妻反目，不能正室也。"
      },
      {
        "position": "六四",
        "original": "有孚。惕出。上合志也。"
      },
      {
        "position": "九五",
        "original": "有孚攣如，不獨富也。"
      },
      {
        "position": "上九",
        "original": "既雨既處，德積載也。君子征凶，有所疑也。"
      }
    ]
  }
