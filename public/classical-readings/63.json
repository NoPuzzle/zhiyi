  "name": "既濟",
  "revisionUrl": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%E6%AD%A3%E7%BE%A9%2F06%E6%97%A2%E6%BF%9F&oldid=2404985",
  "jing": {
    "judgmentOriginal": "亨小，利貞，初吉終亂。",
    "lineTexts": [
      {
        "position": "初九",
        "original": "曳其輪，濡其尾，無咎。"
      },
      {
        "position": "六二",
        "original": "婦喪其茀，勿逐，七日得。"
      },
      {
        "position": "九三",
        "original": "高宗伐鬼方，三年克之，小人勿用。"
      },
      {
        "position": "六四",
        "original": "繻有衣袽，終日戒。"
      },
      {
        "position": "九五",
        "original": "東鄰殺牛，不如西鄰之禴祭，實受其福。"
      },
      {
        "position": "上六",
        "original": "濡其首，厲。"
      }
    ]
  },
  "zhuan": {
    "tuanParagraphs": [
      "既濟，亨，小者亨也。利貞，剛柔正而位當也。初吉，柔得中也。終止則亂，其道窮也。"
    ],
    "greatImageText": "水在火上，既濟。君子以思患而豫防之。",
    "smallImageTexts": [
      {
        "position": "初九",
        "original": "曳其輪，義无咎也。"
      },
      {
        "position": "六二",
        "original": "七日得，以中道也。"
      },
      {
        "position": "九三",
        "original": "三年克之，憊也。"
      },
      {
        "position": "六四",
        "original": "終日戒，有所疑也。"
      },
      {
        "position": "九五",
        "original": "東鄰殺牛，不如西鄰之時也；實受其福，吉大來也。"
      },
      {
        "position": "上六",
        "original": "濡其首厲，何可久也。"
      }
    ]
  }
