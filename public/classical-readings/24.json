  "jing": {
    "judgmentOriginal": "亨。出入無疾，朋來無咎。反復其道，七日來復，利有攸往。",
    "lineTexts": [
      {
        "position": "初九",
        "original": "不遠復，無祗悔，元吉。"
      },
      {
        "position": "六二",
        "original": "休復，吉。"
      },
      {
        "position": "六三",
        "original": "頻復，厲無咎。"
      },
      {
        "position": "六四",
        "original": "中行獨復。"
      },
      {
        "position": "六五",
        "original": "敦復，無悔。"
      },
      {
        "position": "上六",
        "original": "迷復，凶，有災眚。用行師，終有大敗。以其國君凶，至於十年不克征。"
      }
    ]
  },
  "zhuan": {
    "tuanParagraphs": [
      "復亨；剛反，動而以順行，是以出入无疾，朋來无咎。反復其道，七日來復，天行也。利有攸往，剛長也。復其見天地之心乎？"
    ],
    "greatImageText": "雷在地中，復。先王以至日閉關，商旅不行，後不省方。",
    "smallImageTexts": [
      {
        "position": "初九",
        "original": "不遠之復，以修身也。"
      },
      {
        "position": "六二",
        "original": "休復之吉，以下仁也。"
      },
      {
        "position": "六三",
        "original": "頻復之厲，義无咎也。"
      },
      {
        "position": "六四",
        "original": "中行獨復，以從道也。"
      },
      {
        "position": "六五",
        "original": "敦復无悔，中以自考也。"
      },
      {
        "position": "上六",
        "original": "迷復之凶，反君道也。"
      }
    ]
  }
