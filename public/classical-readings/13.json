  "name": "同人",
  "revisionUrl": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%E6%AD%A3%E7%BE%A9%2F02%E5%90%8C%E4%BA%BA&oldid=2000752",
  "jing": {
    "judgmentOriginal": "同人於野，亨，利涉大川，利君子貞。",
    "lineTexts": [
      {
        "position": "初九",
        "original": "同人於門，無咎。"
      },
      {
        "position": "六二",
        "original": "同人於宗，吝。"
      },
      {
        "position": "九三",
        "original": "伏戎於莽，升其高陵，三歲不興。"
      },
      {
        "position": "九四",
        "original": "乘其墉，弗克攻，吉。"
      },
      {
        "position": "九五",
        "original": "同人先號咷，而後笑，大師克相遇。"
      },
      {
        "position": "上九",
        "original": "同人於郊，無悔。"
      }
    ]
  },
  "zhuan": {
    "tuanParagraphs": [
      "同人，柔得位得中，而應乎乾，曰同人。同人曰，同人于野，亨。利涉大川，乾行也。文明以健，中正而應，君子正也。唯君子為能通天下之志。"
    ],
    "greatImageText": "天與火，同人。君子以類族辨物。",
    "smallImageTexts": [
      {
        "position": "初九",
        "original": "出門同人，又誰咎也。"
      },
      {
        "position": "六二",
        "original": "同人于宗，吝道也。"
      },
      {
        "position": "九三",
        "original": "伏戎于莽，敵剛也。三歲不興，安行也。"
      },
      {
        "position": "九四",
        "original": "乘其墉，義弗克也，其吉，則困而反則也。"
      },
      {
        "position": "九五",
        "original": "同人之先，以中直也。大師相遇，言相克也。"
      },
      {
        "position": "上九",
        "original": "同人于郊，志未得也。"
      }
    ]
  }
