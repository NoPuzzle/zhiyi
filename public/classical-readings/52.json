  "name": "艮",
  "revisionUrl": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%E6%AD%A3%E7%BE%A9%2F05%E8%89%AE&oldid=2409039",
  "jing": {
    "judgmentOriginal": "艮其背，不獲其身，行其庭，不見其人，無咎。",
    "lineTexts": [
      {
        "position": "初六",
        "original": "艮其趾，無咎，利永貞。"
      },
      {
        "position": "六二",
        "original": "艮其腓，不拯其隨，其心不快。"
      },
      {
        "position": "九三",
        "original": "艮其限，列其夤，厲薰心。"
      },
      {
        "position": "六四",
        "original": "艮其身，無咎。"
      },
      {
        "position": "六五",
        "original": "艮其輔，言有序，悔亡。"
      },
      {
        "position": "上九",
        "original": "敦艮，吉。"
      }
    ]
  },
  "zhuan": {
    "tuanParagraphs": [
      "艮，止也。時止則止，時行則行，動靜不失其時，其道光明。艮其止，止其所也。上下敵應，不相與也。是以不獲其身，行其庭不見其人，无咎也。"
    ],
    "greatImageText": "兼山，艮，君子以思，不出其位。",
    "smallImageTexts": [
      {
        "position": "初六",
        "original": "艮其趾，未失正也。"
      },
      {
        "position": "六二",
        "original": "不拯其隨，未退聽也。"
      },
      {
        "position": "九三",
        "original": "艮其限，危薰心也。"
      },
      {
        "position": "六四",
        "original": "艮其身，止諸躬也。"
      },
      {
        "position": "六五",
        "original": "艮其輔，以中正也。"
      },
      {
        "position": "上九",
        "original": "敦艮之吉，以厚終也。"
      }
    ]
  }
