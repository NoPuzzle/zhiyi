  "name": "比",
  "revisionUrl": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%E6%AD%A3%E7%BE%A9%2F02%E6%AF%94&oldid=2404944",
  "jing": {
    "judgmentOriginal": "吉，原筮，元永貞，無咎。不甯方來，後夫凶。",
    "lineTexts": [
      {
        "position": "初六",
        "original": "有孚比之，無咎。有孚盈缶，終來有它吉。"
      },
      {
        "position": "六二",
        "original": "比之自內，貞吉。"
      },
      {
        "position": "六三",
        "original": "比之匪人。"
      },
      {
        "position": "六四",
        "original": "外比之，貞吉。"
      },
      {
        "position": "九五",
        "original": "顯比。王用三驅，失前禽。邑人不誡，吉。"
      },
      {
        "position": "上六",
        "original": "比之無首，凶。"
      }
    ]
  },
  "zhuan": {
    "tuanParagraphs": [
      "比，吉也。比，輔也，下順從也。原筮，元永貞，无咎，以剛中也。不寧方來，上下應也。後夫凶，其道窮也。"
    ],
    "greatImageText": "地上有水，比。先王以建萬國，親諸侯。",
    "smallImageTexts": [
      {
        "position": "初六",
        "original": "比之初六，有它吉也。"
      },
      {
        "position": "六二",
        "original": "比之自內，不自失也。"
      },
      {
        "position": "六三",
        "original": "比之匪人，不亦傷乎！"
      },
      {
        "position": "六四",
        "original": "外比於賢，以從上也。"
      },
      {
        "position": "九五",
        "original": "顯比之吉，位正中也。舍逆取順，失前禽也。邑人不誡，上使中也。"
      },
      {
        "position": "上六",
        "original": "比之无首，无所終也。"
      }
    ]
  }
