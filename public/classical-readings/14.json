  "zhuan": {
    "tuanParagraphs": [
      "大有，柔得尊位，大中而上下應之，曰大有。其德剛健而文明，應乎天而時行，是以元亨。"
    ],
    "greatImageText": "火在天上，「大有」。君子以遏惡揚善，順天休命。",
    "smallImageTexts": [
      {
        "position": "初九",
        "original": "大有初九，无交害也。"
      },
      {
        "position": "九二",
        "original": "大車以載，積中不敗也。"
      },
      {
        "position": "九三",
        "original": "公用亨于天子，小人害也。"
      },
      {
        "position": "九四",
        "original": "匪其彭，无咎；明辨晰也。"
      },
      {
        "position": "六五",
        "original": "厥孚交如，信以發志也。威如之吉，易而无備也。"
      },
      {
        "position": "上九",
        "original": "大有上吉，自天佑也。"
      }
    ]
