  "jing": {
    "judgmentOriginal": "元亨。",
    "lineTexts": [
      {
        "position": "初九",
        "original": "無交害。匪咎，艱則無咎。"
      },
      {
        "position": "九二",
        "original": "大車以載，有攸往，無咎。"
      },
      {
        "position": "九三",
        "original": "公用亨於天子，小人弗克。"
      },
      {
        "position": "九四",
        "original": "匪其彭，無咎。"
      },
      {
        "position": "六五",
        "original": "厥孚交如，威如，吉。"
      },
      {
        "position": "上九",
        "original": "自天祐之，吉無不利。"
      }
