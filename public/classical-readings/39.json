  "jing": {
    "judgmentOriginal": "利西南，不利東北。利見大人。貞吉。",
    "lineTexts": [
      {
        "position": "初六",
        "original": "往蹇，來譽。"
      },
      {
        "position": "六二",
        "original": "王臣蹇蹇，匪躬之故。"
      },
      {
        "position": "九三",
        "original": "往蹇，來反。"
      },
      {
        "position": "六四",
        "original": "往蹇，來連。"
      },
      {
        "position": "九五",
        "original": "大蹇，朋來。"
      },
      {
        "position": "上六",
        "original": "往蹇來碩，吉。利見大人。"
